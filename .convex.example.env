# Better Auth application origin. Use the exact frontend origin for each
# deployment, for example http://localhost:5173 in development.
PUBLIC_ORIGIN="http://localhost:5173"

# Better Auth secret. Use a unique 32+ character secret per deployment.
BETTER_AUTH_SECRET="replace-with-a-unique-32-plus-character-secret"

# Google OAuth credentials required when socialProviders.google is enabled in
# src/convex/auth/auth.ts.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# Resend credentials used by Better Auth Email OTP delivery.
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="replace-with-verified-sender"

# Cloudflare Turnstile. The site key is also needed by SvelteKit; keep the
# secret key only in the Convex deployment environment.
PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Cloudflare R2 credentials used by @convex-dev/r2.
STORAGE_ENDPOINT="https://replace-with-storage-endpoint"
STORAGE_ACCESS_KEY_ID="replace-with-storage-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-storage-secret-access-key"
STORAGE_BUCKET_NAME="replace-with-storage-bucket-name"
# Optional permanent public base URL, preferably an R2 custom domain.
# Without it, API responses use one-hour signed R2 URLs.
STORAGE_PUBLIC_URL="https://cdn.example.com"

# Separate private R2 bucket for unvalidated originals.
# Configure PUT CORS and expire originals/ after one day.
STORAGE_TEMP_BUCKET_NAME="replace-with-project-temporary-bucket"
STORAGE_TEMP_ENDPOINT="https://replace-with-account-id.r2.cloudflarestorage.com"
STORAGE_TEMP_ACCESS_KEY_ID="replace-with-temporary-access-key-id"
STORAGE_TEMP_SECRET_ACCESS_KEY="replace-with-temporary-secret-access-key"

# Checkout.com sandbox only. Configure these on the Convex development deployment.
CHECKOUT_API_SECRET="sk_sbox_replace-with-secret-key"
CHECKOUT_API_BASE_URL="https://replace-with-prefix.api.sandbox.checkout.com"
CHECKOUT_PROCESSING_CHANNEL_ID="pc_replace-with-processing-channel"
# Use the same signature key in Checkout.com's webhook configuration.
CHECKOUT_WEBHOOK_SECRET="replace-with-webhook-signature-key"
